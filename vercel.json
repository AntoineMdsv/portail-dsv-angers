{
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/h?p=page" },
    { "source": "/index.html", "destination": "/api/h?p=page" },
    { "source": "/connexion", "destination": "/api/h?p=connexion" },
    { "source": "/api/:p*", "destination": "/api/h?p=:p*" }
  ],
  "functions": {
    "api/h.js": {
      "includeFiles": "pages/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ]
}
